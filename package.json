{
  "name": "germina",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Una semilla de Matemáticas cada semana para jugar en familia.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tipos": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validar": "node scripts/validar-contenido.mjs && node scripts/mapa-semanas.mjs",
    "check": "npm run tipos && npm test && npm run validar && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pove.github.io/germina/esquemas/semilla.schema.json",
  "title": "Semilla de Germina",
  "description": "Contenido de una semana (o de un reto de verano) para un curso. Ver docs/especificacion.md, apartado 4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "ciclo", "area", "curso", "tipo", "titulo", "objetivo", "comoAyudar", "saberes", "criterios", "reto", "preguntas", "revision"],
  "properties": {
    "version": { "const": 1 },
    "id": {
      "description": "ciclo.area.curso.sNN para semanas, ciclo.area.curso.vNN para verano. Coincide con el nombre del archivo.",
      "type": "string",
      "pattern": "^[0-9]\\.[a-z-]+\\.[0-9]\\.(s(0[1-9]|[1-3][0-9]|4[01])|v(0[1-9]|10))$"
    },
    "ciclo": { "type": "integer", "minimum": 1, "maximum": 3 },
    "area": { "type": "string", "pattern": "^[a-z-]+$" },
    "curso": { "type": "integer", "minimum": 1, "maximum": 6 },
    "semana": { "type": "integer", "minimum": 1, "maximum": 41 },
    "verano": { "type": "integer", "minimum": 1, "maximum": 10 },
    "tipo": { "enum": ["tema", "recordar", "verano"] },
    "titulo": { "$ref": "#/$defs/texto" },
    "objetivo": { "$ref": "#/$defs/texto", "description": "Qué descubren esta semana, en lenguaje de familia. Una o dos frases." },
    "comoAyudar": { "$ref": "#/$defs/texto", "description": "Una idea concreta de cómo acompañar esta semana." },
    "saberes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z-]+\\.[a-z-]+\\.[a-z0-9-]+$" } },
    "criterios": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z-]+\\.c[1-3]\\.[1-8]\\.[1-9]$" } },
    "reto": { "$ref": "#/$defs/reto" },
    "preguntas": {
      "description": "Exactamente cinco, en este orden: p1, p2 y p3 del tema; p4 recupera una semana anterior; p5 es «explícamelo».",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/preguntaTema" },
        { "$ref": "#/$defs/preguntaTema" },
        { "$ref": "#/$defs/preguntaTema" },
        { "$ref": "#/$defs/preguntaRecordar" },
        { "$ref": "#/$defs/preguntaExplicamelo" }
      ]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docente", "traducciones"],
      "properties": {
        "docente": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revisada"],
          "properties": {
            "revisada": { "type": "boolean" },
            "fecha": { "type": "string", "format": "date" }
          }
        },
        "traducciones": {
          "type": "object",
          "additionalProperties": false,
          "required": ["va", "en", "fr", "ar"],
          "properties": {
            "va": { "$ref": "#/$defs/estadoTraduccion" },
            "en": { "$ref": "#/$defs/estadoTraduccion" },
            "fr": { "$ref": "#/$defs/estadoTraduccion" },
            "ar": { "$ref": "#/$defs/estadoTraduccion" }
          }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "tipo": { "const": "verano" } } }, "then": { "required": ["verano"], "not": { "required": ["semana"] } }, "else": { "required": ["semana"], "not": { "required": ["verano"] } } }
  ],
  "$defs": {
    "texto": {
      "description": "Un texto en los cinco idiomas. Admite el marcado {{…}} para operaciones y números (se muestran aislados de izquierda a derecha).",
      "type": "object",
      "additionalProperties": false,
      "required": ["es", "va", "en", "fr", "ar"],
      "properties": {
        "es": { "type": "string", "minLength": 1 },
        "va": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "fr": { "type": "string", "minLength": 1 },
        "ar": { "type": "string", "minLength": 1 }
      }
    },
    "estadoTraduccion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estado", "huella"],
      "properties": {
        "estado": { "enum": ["automatica", "revisada"] },
        "huella": { "description": "Huella de los textos en español cuando se tradujo (scripts/lib/huella.mjs). Si no coincide con la actual, la traducción cuenta como automática.", "type": "string", "pattern": "^[0-9a-f]{12}$" }
      }
    },
    "pictograma": {
      "description": "Nombre de un pictograma de la lista cerrada (docs/especificacion.md, apartado 4.6).",
      "enum": ["dado", "cartas", "monedas", "billete", "reloj", "cronometro", "recta", "legumbres", "vaso", "plato", "galleta", "pizza", "papel", "lapiz", "regla", "cinta", "cuerda", "balanza", "botella", "bolsa", "calcetin", "pinza", "boton", "tablero", "palillos", "folleto", "ticket", "mapa", "brujula", "caja", "calendario", "termometro", "casa", "cocina", "sol", "manos", "bocadillo", "fruta", "pan", "huevera", "nevera", "pelota", "domino", "tarjetas", "sobre", "tijeras", "tira", "lupa", "ojo", "conversacion", "huellas", "formas", "angulo", "barras", "arbol", "ascensor"]
    },
    "reto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titulo", "material", "minutos", "pasos", "masFacil", "masDificil", "paraQueSirve"],
      "properties": {
        "titulo": { "$ref": "#/$defs/texto" },
        "material": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/texto" } },
        "minutos": { "type": "integer", "minimum": 5, "maximum": 15 },
        "pasos": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["texto", "pictograma"],
            "properties": { "texto": { "$ref": "#/$defs/texto" }, "pictograma": { "$ref": "#/$defs/pictograma" } }
          }
        },
        "masFacil": { "$ref": "#/$defs/texto" },
        "masDificil": { "$ref": "#/$defs/texto" },
        "paraQueSirve": { "$ref": "#/$defs/texto" },
        "aviso": { "$ref": "#/$defs/texto", "description": "Aviso de seguridad (objetos pequeños, cocina con una persona adulta…)." },
        "rapidez": {
          "description": "Solo si el reto es un juego de rapidez con cronómetro y récord personal.",
          "type": "object",
          "additionalProperties": false,
          "required": ["segundos", "seCuenta"],
          "properties": {
            "segundos": { "enum": [60, 120, 180] },
            "seCuenta": { "$ref": "#/$defs/texto", "description": "Qué se cuenta para el récord, p. ej. «aciertos»." }
          }
        }
      }
    },
    "respuestaCalculo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo", "operacion", "resultado", "texto"],
      "properties": {
        "tipo": { "const": "calculo" },
        "operacion": { "description": "Operación con enteros que da la respuesta: + - × : y paréntesis. Dinero en céntimos, longitudes en cm o mm, masas en g, capacidades en ml y horas en minutos cuando haga falta.", "type": "string", "pattern": "^[0-9+\\-×:() ]+$" },
        "resultado": { "type": "integer" },
        "unidad": { "enum": ["unidades", "cent", "euros", "min", "cm", "mm", "m", "g", "ml"] },
        "texto": { "$ref": "#/$defs/texto", "description": "La respuesta tal como se enseña a la familia." }
      }
    },
    "respuestaAbierta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo", "orientacion"],
      "properties": {
        "tipo": { "const": "abierta" },
        "orientacion": { "$ref": "#/$defs/texto", "description": "Qué se puede esperar o cómo reconducir la conversación." }
      }
    },
    "preguntaBase": {
      "type": "object",
      "required": ["id", "rol", "texto", "pista", "respuesta", "tipoProblema"],
      "properties": {
        "id": { "enum": ["p1", "p2", "p3", "p4", "p5"] },
        "rol": { "enum": ["tema", "recordar", "explicamelo"] },
        "texto": { "$ref": "#/$defs/texto" },
        "pista": { "$ref": "#/$defs/texto" },
        "respuesta": { "oneOf": [{ "$ref": "#/$defs/respuestaCalculo" }, { "$ref": "#/$defs/respuestaAbierta" }] },
        "tipoProblema": { "type": "string", "pattern": "^[a-z-]+$" },
        "inventala": { "$ref": "#/$defs/texto", "description": "Propuesta de «y ahora invéntala tú»." },
        "recupera": { "description": "Semana que se recupera (p4). 0 = el curso anterior (solo en la semana 1).", "type": "integer", "minimum": 0, "maximum": 41 }
      }
    },
    "preguntaTema": {
      "allOf": [{ "$ref": "#/$defs/preguntaBase" }],
      "properties": { "rol": { "const": "tema" }, "id": { "enum": ["p1", "p2", "p3"] }, "texto": true, "pista": true, "respuesta": true, "tipoProblema": true, "inventala": true },
      "required": ["inventala"],
      "not": { "required": ["recupera"] },
      "unevaluatedProperties": false
    },
    "preguntaRecordar": {
      "allOf": [{ "$ref": "#/$defs/preguntaBase" }],
      "properties": { "rol": { "const": "recordar" }, "id": { "const": "p4" }, "texto": true, "pista": true, "respuesta": true, "tipoProblema": true, "inventala": true, "recupera": true },
      "required": ["recupera"],
      "unevaluatedProperties": false
    },
    "preguntaExplicamelo": {
      "allOf": [{ "$ref": "#/$defs/preguntaBase" }],
      "properties": { "rol": { "const": "explicamelo" }, "id": { "const": "p5" }, "texto": true, "pista": true, "respuesta": { "$ref": "#/$defs/respuestaAbierta" }, "tipoProblema": { "const": "abierta" } },
      "not": { "anyOf": [{ "required": ["recupera"] }, { "required": ["inventala"] }] },
      "unevaluatedProperties": false
    }
  }
}

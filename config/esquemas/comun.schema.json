{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pove.github.io/germina/esquemas/comun.schema.json",
  "title": "Archivos de contenido común de Germina",
  "description": "Esquemas de textos-interfaz.json, glosario.json, como-ayudar.json y objetivos.json. Ver docs/especificacion.md, apartado 4.7.",
  "$defs": {
    "texto": {
      "description": "Un texto en los cinco idiomas.",
      "type": "object",
      "additionalProperties": false,
      "required": ["es", "va", "en", "fr", "ar"],
      "properties": {
        "es": { "type": "string", "minLength": 1 },
        "va": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "fr": { "type": "string", "minLength": 1 },
        "ar": { "type": "string", "minLength": 1 }
      }
    },
    "textosInterfaz": {
      "description": "Clave en español sin tildes (boton.lo_hemos_jugado) → texto. Los huecos van entre llaves simples: {n}.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
      "additionalProperties": { "$ref": "#/$defs/texto" }
    },
    "glosario": {
      "description": "Vocabulario de clase en español y su traducción fija.",
      "type": "array",
      "minItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["es", "va", "en", "fr", "ar"],
        "properties": {
          "es": { "type": "string", "minLength": 1 },
          "va": { "type": "string", "minLength": 1 },
          "en": { "type": "string", "minLength": 1 },
          "fr": { "type": "string", "minLength": 1 },
          "ar": { "type": "string", "minLength": 1 },
          "nota": { "type": "string", "minLength": 1, "description": "Explicación en español para quien revise o traduzca." }
        }
      }
    },
    "comoAyudar": {
      "description": "Cómo ayudar: las ideas de siempre, por qué Germina y las fuentes que lo respaldan.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ideas", "porque", "fuentes"],
      "properties": {
        "porque": {
          "description": "Por qué Germina, en párrafos cortos: qué es, que no sustituye al cole y en qué se apoya.",
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/texto" }
        },
        "ideas": {
          "description": "Cinco a ocho ideas cortas, siempre las mismas a lo largo del curso.",
          "type": "array",
          "minItems": 5,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/texto" }
        },
        "fuentes": { "$ref": "#/$defs/fuentes" }
      }
    },
    "objetivos": {
      "description": "Qué aprenden: entrada, frases por curso y trimestre, bloques de saberes del ciclo y fuentes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["entrada", "cursos", "bloques", "fuentes"],
      "properties": {
        "entrada": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/texto" } },
        "cursos": {
          "description": "Por curso y trimestre, de tres a cinco frases en lenguaje de familia.",
          "type": "object",
          "additionalProperties": false,
          "required": ["3", "4"],
          "properties": {
            "3": { "$ref": "#/$defs/objetivosDeUnCurso" },
            "4": { "$ref": "#/$defs/objetivosDeUnCurso" }
          }
        },
        "bloques": {
          "description": "Los bloques de saberes del ciclo, una frase cada uno.",
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/texto" }
        },
        "fuentes": { "$ref": "#/$defs/fuentes" }
      }
    },
    "fuentes": {
      "description": "Fuentes citadas. La cita va tal cual, en su idioma; «apoya» dice en los cinco idiomas qué respalda.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cita", "idioma", "url", "apoya"],
        "properties": {
          "cita": { "type": "string", "minLength": 1 },
          "idioma": { "description": "Idioma de la cita, para `lang`.", "enum": ["es", "va", "en", "fr", "ar"] },
          "url": { "type": "string", "pattern": "^https://\\S+$" },
          "apoya": { "$ref": "#/$defs/texto" }
        }
      }
    },
    "objetivosDeUnCurso": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1", "2", "3"],
      "properties": {
        "1": { "$ref": "#/$defs/frases" },
        "2": { "$ref": "#/$defs/frases" },
        "3": { "$ref": "#/$defs/frases" }
      }
    },
    "frases": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "$ref": "#/$defs/texto" } }
  }
}
